# ─────────────────────────────────────────────────────
#  Shop & Inventory — Environment Variables
# ─────────────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# On Vercel, set these in: Project → Settings → Environment Variables
#

# Neon / Supabase / Any PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# JWT signing secret — change to a random 64-char string in production
JWT_SECRET=change-me-to-a-long-random-secret-string-in-production

# Optional: API server port for local dev (default 3001)
# API_PORT=3001
